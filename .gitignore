# Data / artifacts
*.parquet
*.csv
# Frozen result files backing the paper. The old rule matched one level only,
# so per-cutoff results (exp_014_transfer_ladder/f33/pairs.csv) stayed ignored
# and verify_paper_claims.py could not run from a fresh clone.
!data/artifacts/experiments/**/*.csv
# ...except the per-student OULAD snapshots, 15-24 MB each. The adapter rebuilds
# them from the raw release; they are an intermediate, not a result.
data/artifacts/experiments/*/oulad_weekly_snapshots.csv

# Raw dataset releases: downloaded locally, never committed. How to get each one
# is in datasets/PROVENANCE.md. The rule here used to name
# datasets/ku_leuven/dataset.zip, but the archive is called dataset_full.zip, so
# 75 MB was tracked for months without anyone noticing.
datasets/oulad/
datasets/ku_leuven/*
!datasets/ku_leuven/*.json
*.pkl
*.joblib
*.onnx
data/application/
*.sqlite
*.sqlite3

# OS / IDE
.DS_Store
.vscode/
.idea/

# Logs
*.log

# Build caches / review-scratch (Next.js custom distDir from automated reviews)
.next-review/
.next-rev-*/
*.tsbuildinfo
# Playwright MCP scratch
.playwright-mcp/

# UKZN raw dataset (Zenodo 14810607, 316MB; downloaded locally, never committed)
datasets/ukzn/

# Zambia CS1 raw dataset (Zenodo 21292883; downloaded locally, never committed)
datasets/zambia/
# Candidate datasets under evaluation
datasets/_candidates/

# Word manuscripts kept on disk but out of version control (moved 2026-09-06)
_local/
